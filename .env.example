# Copy to `.env` in repo root.

# --- Default: local Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
CAPRIGO_LLM_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5-coder:7b

# 8GB / scrap GPUs: lean tool catalog (~17 tools vs full catalog)
CAPRIGO_LEAN_TOOLS=1

# --- Alternative: LM Studio / OpenAI-compatible harness ---
# CAPRIGO_LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# DEFAULT_MODEL=qwen2.5-coder-7b-instruct
# CAPRIGO_HARNESS_MODE=1
# CAPRIGO_FAST_MODEL=google/gemma-3-4b

# Optional tuning
# CAPRIGO_OLLAMA_NUM_GPU=99
# CAPRIGO_OLLAMA_TIMEOUT_MS=600000
# CAPRIGO_BIND_HOST=127.0.0.1
# CAPRIGO_API_TOKEN=

# Desktop / browser body (Windows)
# CAPRIGO_DISABLE_DESKTOP=1
# CAPRIGO_DISABLE_BROWSER=1

# Web search
# CAPRIGO_WEB_SEARCH=auto

# Vibes-Coded marketplace
# VIBES_CODED_API_BASE=https://vibes-coded.com/api
# VIBES_CODED_API_KEY=
