# Copy to `.env` in this repo root (loaded by the gateway via `packages/gateway` → `env-bootstrap`).
# Remote Ollama on your LAN (use the host IP that runs `ollama serve`, default port 11434):
OLLAMA_URL=http://10.0.0.15:11434
MERCURY_LLM_PROVIDER=ollama

# Per LLM request (each tool round is a separate request). Default 600000 ms (10 min); raise for very slow CPU/GPU.
# MERCURY_OLLAMA_TIMEOUT_MS=600000

# Optional: label shown in the UI / health
# MERCURY_LLM_BADGE=LAN

# Optional: Mercury marketplace home / Vibes-Coded integration
# VIBES_CODED_API_BASE=https://vibes-coded.com/api
# VIBES_CODED_API_KEY=your_vibes_api_key

# Optional: lock down remote mutation if you bind beyond localhost
# MERCURY_BIND_HOST=127.0.0.1
# MERCURY_API_TOKEN=change_me_for_remote_access
