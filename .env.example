# Copy to `.env` in this repo root (loaded by the gateway via `packages/gateway` → `env-bootstrap`).

# Local Ollama (default). For a LAN box, point at that host's :11434 instead.
OLLAMA_URL=http://127.0.0.1:11434
CAPRIGO_LLM_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5-coder:7b

# Agent-friendly on 8GB VRAM: prefer 3B–7B Q4, keep context modest (8k–16k day-to-day).
# CAPRIGO_OLLAMA_NUM_GPU=99
# CAPRIGO_OLLAMA_TIMEOUT_MS=600000

# Lean tools (recommended on scrap / 8GB GPUs): only core filesystem/web/shell/memory schemas
# are sent each turn unless the agent has assignedSkills. Cuts ~170 → ~17 tools.
# Also auto-on when Settings → laptopMode is enabled. Set =0 to force full catalog.
CAPRIGO_LEAN_TOOLS=1

# Optional: label shown in the UI / health
# CAPRIGO_LLM_BADGE=local

# Optional: Vibes-Coded marketplace integration
# VIBES_CODED_API_BASE=https://vibes-coded.com/api
# VIBES_CODED_API_KEY=your_vibes_api_key

# Optional: lock down remote mutation if you bind beyond localhost
# CAPRIGO_BIND_HOST=127.0.0.1
# CAPRIGO_API_TOKEN=change_me_for_remote_access
