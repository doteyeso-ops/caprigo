# Caprigo — LM Studio CLI harness (copy to `.env` in repo root)

# Default: OpenAI-compatible → LM Studio local server
CAPRIGO_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=  # optional for local LM Studio
DEFAULT_MODEL=qwen2.5-coder-7b-instruct
# Avoid llama-3-groq-*-tool-use on LM Studio — often ignores tools[] (Caprigo HOME auto-drains playbooks anyway).
# Optional small model for final answers after tools (faster prefill). Caprigo briefs/compresses context first.
# CAPRIGO_FAST_MODEL=google/gemma-3-4b
# CAPRIGO_PROMPT_BRIEF=1

# Long-horizon agent budgets (coding / computer-use missions). Set 0 to disable.
CAPRIGO_HARNESS_MODE=1

# Optional: hint hosts for `caprigo connect` (comma-separated)
# CAPRIGO_LMSTUDIO_HOSTS=10.0.0.27,10.0.0.15

# Optional: Ollama instead
# CAPRIGO_LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# DEFAULT_MODEL=qwen2.5-coder:7b

# Browser computer-use (Playwright). Install: npm i playwright && npx playwright install chromium
# CAPRIGO_DISABLE_BROWSER=1
# CAPRIGO_BROWSER_HEADLESS=0   # set 0 to watch the browser body; default may be headless
# CAPRIGO_BROWSER_HEADLESS=1

# Desktop digital body (Windows Win32 mouse/keyboard/screenshot). Enabled by default on Windows.
# CAPRIGO_DISABLE_DESKTOP=1
# CAPRIGO_DESKTOP_SMOKE_CLICK=1  # optional: smoke-desktop.cjs also clicks (0,0)
# Desktop OCR — default auto uses fast Windows.Media.Ocr (~2s). Optional RapidOCR venv for harder text.
# CAPRIGO_OCR_ENGINE=auto        # auto | winrt | rapidocr
# CAPRIGO_OCR_PYTHON=            # override path to python with rapidocr-onnxruntime
# Setup RapidOCR: powershell -File scripts/setup-desktop-ocr.ps1

# Image generation skill (Hermes-style — NOT an LM Studio chat model)
# CAPRIGO_IMAGE_PROVIDER=a1111   # a1111 | openai | http | auto
# CAPRIGO_IMAGE_BASE_URL=http://10.0.0.27:7860
# CAPRIGO_IMAGE_STEPS=15         # RX580-friendly default
# CAPRIGO_IMAGE_SIZE=512
# CAPRIGO_IMAGE_SAMPLER=Euler a
# CAPRIGO_IMAGE_NEGATIVE=blurry, low quality, watermark, text, deformed
# CAPRIGO_IMAGE_API_KEY=
# CAPRIGO_IMAGE_MODEL=           # openai images model id if needed
# RX 580 (~8GB): Forge/A1111 + SD 1.5; do not load Flux into LM Studio

# Web search — default Brave HTML (no key). Optional API keys only if you want them.
# CAPRIGO_WEB_SEARCH=auto        # auto | brave | gemini | ddg
# BRAVE_API_KEY=                 # optional official API; otherwise search.brave.com HTML
# GEMINI_API_KEY=                # optional Google AI grounding
# CAPRIGO_GEMINI_SEARCH_MODEL=gemini-2.5-flash
# CAPRIGO_DISABLE_WEB_TOOLS=1

# Stumble-to-walk + Caprigo Brain + Model Grapple
# CAPRIGO_STUMBLE=1
# CAPRIGO_STUMBLE_MAX=3
# CAPRIGO_STUMBLE_VERIFY_MAX=3
# CAPRIGO_TOOL_DIALECT=auto      # openai | xml | legacy | auto
# CAPRIGO_EMBEDDED_TOOLS=        # 1 force XML; 0 force OpenAI tools[]
# CAPRIGO_MODEL_HANDSHAKE=1      # on | always | off
# CAPRIGO_PROFILE_TTL_MS=604800000
# CAPRIGO_CORE_TOOLS_ONLY=0
# CAPRIGO_ALLOW_SKILL_SPAWN=0    # 1 allows create_skill to write index.js

# Embedded TUI is default. Force gateway-attached TUI:
# CAPRIGO_TUI_GATEWAY=1

# Optional marketplace
# VIBES_CODED_API_BASE=https://vibes-coded.com/api
# VIBES_CODED_API_KEY=

# Gateway (caprigo serve)
# CAPRIGO_BIND_HOST=127.0.0.1
# CAPRIGO_API_TOKEN=
